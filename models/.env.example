# Copy this file to .env and fill in your real values.
# .env is git-ignored -- never commit real credentials.

# ============================================================
# Database connection (PostgreSQL)
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pakwheels
DB_USER=postgres
DB_PASSWORD=changeme
DB_SCHEMA=cars

# Alternative: set the full connection string directly instead of
# the pieces above. If set, this takes priority.
# DATABASE_URL=postgresql+psycopg2://postgres:changeme@localhost:5432/pakwheels

# ============================================================
# Feature-engineering assumptions (see config/settings.py for
# what each one controls and why it's an assumption, not a fact)
# ============================================================

# Fallback reference year for car_age, used only when a row has no
# usable scrape_date.
FALLBACK_CURRENT_YEAR=2026

# Assumed average kilometres driven per year in Pakistan, used for
# mileage_ratio / is_high_mileage / is_low_mileage.
AVERAGE_KM_PER_YEAR=12000
