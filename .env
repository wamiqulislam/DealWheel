# Copy this file to .env and fill in real values. .env is read automatically
# via python-dotenv (see settings.py) — never commit the real .env.

# Required
DATABASE_URL=postgresql+psycopg2://postgres:12345@host:5432/dealwheel

# Optional — leave blank to scrape without a proxy
PROXY_URL=

# Optional tuning (defaults shown)
SCRAPY_CONCURRENT_REQUESTS=16
RANDOM_DELAY_MIN=0.3
RANDOM_DELAY_MAX=1
LOG_LEVEL=INFO
LOG_FILE=logs/dealwheel_scraper.log
